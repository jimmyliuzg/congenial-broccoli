---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

const order = ['2:30am', 'oscars-2026', 'rcl-daily'];

const projects = allProjects.sort((a, b) => {
  const aIndex = order.indexOf(a.data.title);
  const bIndex = order.indexOf(b.data.title);
  if (aIndex !== -1 && bIndex !== -1) return aIndex - bIndex;
  if (aIndex !== -1) return -1;
  if (bIndex !== -1) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const isNew = (dateStr: string) => {
  const projectDate = new Date(dateStr);
  const now = new Date();
  const daysDiff = (now.getTime() - projectDate.getTime()) / (1000 * 60 * 60 * 24);
  return daysDiff <= 30;
};
---

<BaseLayout title="Projects — Jimmy Liu"> <!-- ← USER INPUT NEEDED -->
  
  <h1 class="text-4xl font-bold mb-8 text-link dark:text-link-dark">Projects</h1>
  
  <div class="space-y-8">
    {projects.map(project => (
      <div class="mb-8">
        <h2 class="text-xl font-bold mb-2 flex items-center gap-2">
          <a href={`/projects/${project.slug}`} class="underline text-link dark:text-link-dark hover:opacity-70">
            {project.data.title}
          </a>
          {isNew(project.data.date) && (
            <span class="text-xs px-2 py-0.5 bg-red-600 text-white font-bold rounded">NEW</span>
          )}
        </h2>
        <p class="mb-3 text-light-text dark:text-dark-text">
          {project.data.description}
        </p>
        {project.data.tags && project.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-3">
            {project.data.tags.map((tag: string) => (
              <span class="text-xs px-2 py-1 border border-gray-400 dark:border-gray-600 text-light-text dark:text-dark-text">{tag}</span>
            ))}
          </div>
        )}
        <p class="text-sm text-light-text dark:text-dark-text">
          {project.data.demoUrl && (
            <>
              <a href={project.data.demoUrl} target="_blank" rel="noopener" class="underline">View demo</a>,{' '}
            </>
          )}
          {project.data.githubUrl && (
            <>
              <a href={project.data.githubUrl} target="_blank" rel="noopener" class="underline">view source</a>,{' '}
            </>
          )}
          <a href={`/projects/${project.slug}`} class="underline">read more</a>.
        </p>
      </div>
    ))}
  </div>

</BaseLayout>

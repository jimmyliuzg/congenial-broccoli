---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const writingPosts = (await getCollection("writing")).map((post) => ({
  ...post,
  type: "writing" as const,
}));

const journalPosts = (await getCollection("journal")).map((post) => ({
  ...post,
  type: "field-notes" as const,
}));

const allPosts = [...writingPosts, ...journalPosts].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
---

<BaseLayout title="Writing — Jimmy Liu">
  <div class="max-w-3xl">
    <h1 class="text-4xl font-bold mb-4 text-link dark:text-link-dark">
      Writing
    </h1>
    <p class="text-lg opacity-80 mb-8">
      Thoughts on technology, building, and whatever else is on my mind.
    </p>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap gap-2 mb-10" id="writing-filters">
      <button
        class="filter-btn px-4 py-2 text-sm font-medium border-2 transition bg-black dark:bg-white text-white dark:text-black border-black dark:border-white"
        data-filter="all"
      >
        All
      </button>
      <button
        class="filter-btn px-4 py-2 text-sm font-medium border-2 transition border-black/20 dark:border-white/20 hover:border-black dark:hover:border-white"
        data-filter="writing"
      >
        Writing
      </button>
      <button
        class="filter-btn px-4 py-2 text-sm font-medium border-2 transition border-black/20 dark:border-white/20 hover:border-black dark:hover:border-white"
        data-filter="field-notes"
      >
        Field Notes
      </button>
    </div>

    <!-- Posts List -->
    <div class="space-y-0" id="posts-list">
      {
        allPosts.map((post) => {
          const postDate = new Date(post.data.date);
          const formattedDate = postDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          });
          const isJournal = post.type === "field-notes";
          const href = isJournal
            ? `/journal/${post.slug}`
            : `/writing/${post.slug}`;

          return (
            <article
              class="group border-l-4 border-black dark:border-white pl-6 py-6 hover:bg-black/5 dark:hover:bg-white/5 transition"
              data-type={post.type}
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-2">
                    <time class="text-sm font-mono opacity-60">
                      {formattedDate}
                    </time>
                    {isJournal && (
                      <span class="text-xs px-2 py-0.5 border border-black/20 dark:border-white/20 opacity-70 font-medium">
                        Field Notes
                      </span>
                    )}
                  </div>
                  <h2 class="text-xl font-bold group-hover:underline">
                    <a href={href}>{post.data.title}</a>
                  </h2>
                  <p class="text-sm opacity-80 mt-2">
                    {post.data.description}
                  </p>
                </div>
                <a
                  href={href}
                  class="text-2xl opacity-40 group-hover:opacity-100 transition mt-2"
                >
                  →
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll(".filter-btn");
  const posts = document.querySelectorAll("[data-type]");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.getAttribute("data-filter");

      // Update button styles
      filterBtns.forEach((b) => {
        b.classList.remove(
          "bg-black",
          "dark:bg-white",
          "text-white",
          "dark:text-black",
          "border-black",
          "dark:border-white"
        );
        b.classList.add("border-black/20", "dark:border-white/20");
      });
      btn.classList.add(
        "bg-black",
        "dark:bg-white",
        "text-white",
        "dark:text-black",
        "border-black",
        "dark:border-white"
      );
      btn.classList.remove("border-black/20", "dark:border-white/20");

      // Filter posts
      posts.forEach((post) => {
        const type = post.getAttribute("data-type");
        if (filter === "all" || type === filter) {
          (post as HTMLElement).style.display = "block";
        } else {
          (post as HTMLElement).style.display = "none";
        }
      });
    });
  });
</script>

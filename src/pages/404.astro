---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found — Jimmy Liu">
  <div class="max-w-3xl">
    <span class="utrecht-index">404 / Not found</span>
    <h1 class="text-4xl md:text-5xl font-bold mb-6">Off the map.</h1>
    <p class="text-lg opacity-80 mb-8">
      That page doesn't exist. Try the shelves instead:
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/" class="btn-secondary">Home</a>
      <a href="/writing" class="btn-secondary">Writing</a>
      <a href="/projects" class="btn-secondary">Projects</a>
    </div>
  </div>
</BaseLayout>

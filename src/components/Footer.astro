---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links?: NavLink[];
  topHref?: string;
}

const { links = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects" },
  { label: "Writing", href: "/writing" },
  { label: "Journal", href: "/journal" },
  { label: "Contact", href: "/contact" },
], topHref = "/" } = Astro.props;
---

<!-- Footer — Utrecht inverted signal block -->
<footer class="mt-24 bg-accent dark:bg-accent-dark text-white dark:text-dark-bg">
  <div class="max-w-6xl mx-auto px-5 md:px-10 py-10 flex flex-col md:flex-row gap-8 md:items-start md:justify-between">
    <div class="max-w-xs">
      <p class="font-bold text-lg leading-tight">Jimmy Liu</p>
      <p class="mt-2 text-sm opacity-90 leading-relaxed">
        Technical Program Manager, ML Operations — NVIDIA.<br />
        Bay Area, CA
      </p>
    </div>
    <nav class="text-xs font-medium uppercase tracking-[0.08em]">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 md:justify-end">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-white dark:text-dark-bg hover:opacity-70 transition-opacity">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 opacity-90 md:justify-end">
        <li><a href="https://github.com/jimmyliuzg" target="_blank" rel="noopener" class="text-white dark:text-dark-bg hover:opacity-70 transition-opacity">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/jimmy-l-92b028112/" target="_blank" rel="noopener" class="text-white dark:text-dark-bg hover:opacity-70 transition-opacity">LinkedIn</a></li>
        <li><a href="mailto:jimmyliuzg@gmail.com" class="text-white dark:text-dark-bg hover:opacity-70 transition-opacity">Email</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/40 dark:border-dark-bg/30">
    <div class="max-w-6xl mx-auto px-5 md:px-10 py-4 flex justify-between text-[11px] uppercase tracking-[0.08em] opacity-90">
      <span>© {new Date().getFullYear()} Jimmy Liu</span>
      <a href={topHref} class="text-white dark:text-dark-bg hover:opacity-70 transition-opacity">Back to top ↑</a>
    </div>
  </div>
</footer>
